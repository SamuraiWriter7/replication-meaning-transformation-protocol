
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rmtp/schemas/replication-lineage-graph-v0.4.schema.json",
  "title": "RMTP v0.4 Replication Lineage Graph",
  "description": "Represents a rooted, multi-generation replication ancestry graph. Schema validation checks record structure; semantic validation must verify rootedness, acyclicity, unique ancestry, generation depth, and cross-plan consistency. This graph does not grant replication or execution authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "graph_id",
    "root_agent_id",
    "nodes",
    "edges",
    "verification_time",
    "execution_authorized"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.4.0"
    },
    "graph_id": {
      "$ref": "#/$defs/identifier",
      "description": "Unique identifier of the lineage graph."
    },
    "root_agent_id": {
      "$ref": "#/$defs/identifier",
      "description": "Identifier of the generation-zero agent."
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1001,
      "items": {
        "$ref": "#/$defs/lineage_node"
      },
      "description": "Root agent and its descendant nodes. Node identifiers must be unique; this requires semantic validation."
    },
    "edges": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/lineage_edge"
      },
      "description": "Directed parent-to-offspring ancestry relationships."
    },
    "verification_time": {
      "type": "string",
      "format": "date-time",
      "description": "Time at which lineage consistency is evaluated."
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "unverified",
        "inconclusive",
        "rejected"
      ],
      "description": "Claimed graph verification state. A verified claim must be supported by external evidence."
    },
    "verification_ref": {
      "$ref": "#/$defs/identifier",
      "description": "Reference to the verification assessment."
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "description": "Supporting references for ancestry and cross-plan assessment."
    },
    "execution_authorized": {
      "type": "boolean",
      "const": false,
      "description": "A lineage graph never grants execution authority."
    },
    "notes": {
      "type": "string",
      "maxLength": 2048
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "lineage_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "generation_depth",
        "node_type"
      ],
      "properties": {
        "agent_id": {
          "$ref": "#/$defs/identifier"
        },
        "generation_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "node_type": {
          "type": "string",
          "enum": [
            "root",
            "offspring"
          ]
        },
        "parent_agent_id": {
          "$ref": "#/$defs/identifier",
          "description": "Immediate replication parent. Required for offspring."
        },
        "origin_plan_ref": {
          "$ref": "#/$defs/identifier",
          "description": "Plan that originally produced this offspring."
        },
        "authority_ref": {
          "$ref": "#/$defs/identifier",
          "description": "Reference to the relevant authority record. Its presence does not imply valid delegation."
        },
        "lineage_ref": {
          "$ref": "#/$defs/identifier",
          "description": "Reference to the originating lineage evidence."
        },
        "lifecycle_state": {
          "type": "string",
          "enum": [
            "UNKNOWN",
            "PROPOSED",
            "DEPLOYED",
            "ACTIVE",
            "TERMINATING",
            "TERMINATED",
            "RETIRED"
          ],
          "description": "State recorded at the graph verification context; this must be reconciled with lifecycle receipts."
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "node_type": {
                "const": "root"
              }
            },
            "required": [
              "node_type"
            ]
          },
          "then": {
            "properties": {
              "generation_depth": {
                "const": 0
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "parent_agent_id"
                  ]
                },
                {
                  "required": [
                    "origin_plan_ref"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "node_type": {
                "const": "offspring"
              }
            },
            "required": [
              "node_type"
            ]
          },
          "then": {
            "required": [
              "parent_agent_id",
              "origin_plan_ref",
              "lineage_ref"
            ],
            "properties": {
              "generation_depth": {
                "minimum": 1
              }
            }
          }
        }
      ]
    },
    "lineage_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "parent_agent_id",
        "offspring_agent_id",
        "origin_plan_ref",
        "lineage_ref",
        "evidence_refs"
      ],
      "properties": {
        "edge_id": {
          "$ref": "#/$defs/identifier"
        },
        "parent_agent_id": {
          "$ref": "#/$defs/identifier"
        },
        "offspring_agent_id": {
          "$ref": "#/$defs/identifier"
        },
        "origin_plan_ref": {
          "$ref": "#/$defs/identifier"
        },
        "lineage_ref": {
          "$ref": "#/$defs/identifier"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "verified",
            "unverified",
            "inconclusive",
            "rejected"
          ]
        },
        "verification_ref": {
          "$ref": "#/$defs/identifier"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_status": {
                "const": "verified"
              }
            },
            "required": [
              "verification_status"
            ]
          },
          "then": {
            "required": [
              "verification_ref"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verification_status": {
            "const": "verified"
          }
        },
        "required": [
          "verification_status"
        ]
      },
      "then": {
        "required": [
          "verification_ref"
        ],
        "properties": {
          "evidence_refs": {
            "minItems": 1
          }
        },
        "required": [
          "verification_ref",
          "evidence_refs"
        ]
      }
    }
  ]
}
