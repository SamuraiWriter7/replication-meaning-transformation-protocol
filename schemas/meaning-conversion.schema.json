
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/replication-meaning-transformation-protocol/blob/main/schemas/meaning-conversion.schema.json",
  "title": "RMTP Meaning Conversion v0.1",
  "description": "Evaluates structural deficits and maps replication intents to bounded, non-executable outcomes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "conversion_id",
    "intent_ref",
    "deficit_assessment",
    "evaluated_alternatives",
    "selected_outcome",
    "rationale"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "conversion_id": {
      "$ref": "#/$defs/identifier"
    },
    "intent_ref": {
      "$ref": "#/$defs/identifier"
    },
    "deficit_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deficit_type",
        "verification_status",
        "evidence_refs",
        "necessity"
      ],
      "properties": {
        "deficit_type": {
          "type": "string",
          "enum": [
            "capacity",
            "resilience",
            "coverage",
            "latency",
            "continuity",
            "none",
            "unknown"
          ]
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "verified",
            "unverified",
            "inconclusive"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "necessity": {
          "type": "string",
          "enum": [
            "required",
            "optional",
            "not_required",
            "undetermined"
          ]
        }
      }
    },
    "evaluated_alternatives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alternative_id",
          "strategy",
          "feasible",
          "rationale"
        ],
        "properties": {
          "alternative_id": {
            "$ref": "#/$defs/identifier"
          },
          "strategy": {
            "type": "string",
            "enum": [
              "no_replication",
              "load_redistribution",
              "state_backup",
              "task_deferment",
              "bounded_replication",
              "other"
            ]
          },
          "feasible": {
            "type": "boolean"
          },
          "rationale": {
            "$ref": "#/$defs/explanation"
          }
        }
      },
      "contains": {
        "type": "object",
        "properties": {
          "strategy": {
            "const": "no_replication"
          }
        },
        "required": [
          "strategy"
        ]
      }
    },
    "selected_outcome": {
      "type": "string",
      "enum": [
        "NO_REPLICATION",
        "ALTERNATIVE_PROPOSED",
        "REPLICATION_PROPOSED",
        "HELD_FOR_REVIEW"
      ]
    },
    "selected_alternative_ref": {
      "$ref": "#/$defs/identifier"
    },
    "proposed_instance_count": {
      "type": "integer",
      "minimum": 1
    },
    "authority_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "authority_ref"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "within_scope",
            "insufficient",
            "expired",
            "unknown"
          ]
        },
        "authority_ref": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "rationale": {
      "$ref": "#/$defs/explanation"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "explanation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "selected_outcome": {
            "const": "REPLICATION_PROPOSED"
          }
        },
        "required": [
          "selected_outcome"
        ]
      },
      "then": {
        "required": [
          "selected_alternative_ref",
          "proposed_instance_count",
          "authority_assessment"
        ],
        "properties": {
          "deficit_assessment": {
            "properties": {
              "verification_status": {
                "const": "verified"
              },
              "necessity": {
                "const": "required"
              },
              "evidence_refs": {
                "minItems": 1
              }
            }
          },
          "authority_assessment": {
            "properties": {
              "status": {
                "const": "within_scope"
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "proposed_instance_count"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "deficit_assessment": {
            "properties": {
              "verification_status": {
                "enum": [
                  "unverified",
                  "inconclusive"
                ]
              }
            },
            "required": [
              "verification_status"
            ]
          }
        },
        "required": [
          "deficit_assessment"
        ]
      },
      "then": {
        "properties": {
          "selected_outcome": {
            "enum": [
              "NO_REPLICATION",
              "HELD_FOR_REVIEW"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authority_assessment": {
            "properties": {
              "status": {
                "enum": [
                  "insufficient",
                  "expired",
                  "unknown"
                ]
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "authority_assessment"
        ]
      },
      "then": {
        "properties": {
          "selected_outcome": {
            "not": {
              "const": "REPLICATION_PROPOSED"
            }
          }
        }
      }
    }
  ]
}
