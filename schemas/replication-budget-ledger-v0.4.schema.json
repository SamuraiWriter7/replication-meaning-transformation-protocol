
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rmtp/schemas/replication-budget-ledger-v0.4.schema.json",
  "title": "RMTP v0.4 Replication Budget Ledger",
  "description": "Records bounded replication-slot reservations, active allocations, and independently verified releases across multiple replication plans. This ledger is an auditable snapshot, not an execution authorization or an atomic transaction system.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger_id",
    "propagation_envelope_ref",
    "budget_limit",
    "allocations",
    "verification_time",
    "execution_authorized"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.4.0"
    },
    "ledger_id": {
      "$ref": "#/$defs/identifier",
      "description": "Unique identifier of this budget ledger snapshot."
    },
    "propagation_envelope_ref": {
      "$ref": "#/$defs/identifier",
      "description": "Propagation envelope whose shared population budget this ledger accounts for."
    },
    "budget_limit": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "description": "Maximum number of concurrently committed descendant slots. This value must not exceed the corresponding envelope limit."
    },
    "allocations": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/allocation"
      },
      "description": "Plan-attributed slot allocations. Allocation IDs and plan bindings are checked by the semantic validator."
    },
    "snapshot_sequence": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonically increasing sequence within a trusted ledger history."
    },
    "previous_ledger_ref": {
      "$ref": "#/$defs/identifier",
      "description": "Previous immutable ledger snapshot, when available."
    },
    "snapshot_status": {
      "type": "string",
      "enum": [
        "current",
        "stale",
        "inconclusive"
      ],
      "description": "Declared snapshot freshness. Only independently verified current snapshots may support a new PASS decision."
    },
    "snapshot_totals": {
      "$ref": "#/$defs/snapshot_totals",
      "description": "Optional aggregate counters. Values must be recomputed and checked against allocations."
    },
    "verification_time": {
      "type": "string",
      "format": "date-time",
      "description": "Time at which budget consistency is assessed."
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "unverified",
        "inconclusive",
        "rejected"
      ]
    },
    "verification_ref": {
      "$ref": "#/$defs/identifier"
    },
    "verification_method": {
      "type": "string",
      "enum": [
        "external_registry",
        "signed_attestation",
        "trusted_test_fixture"
      ]
    },
    "verifier_id": {
      "$ref": "#/$defs/identifier"
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "execution_authorized": {
      "type": "boolean",
      "const": false,
      "description": "A budget ledger never authorizes replication or execution."
    },
    "notes": {
      "type": "string",
      "maxLength": 2048
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allocation_id",
        "plan_ref",
        "parent_agent_id",
        "reserved_instances",
        "active_instances",
        "released_instances",
        "allocation_status"
      ],
      "properties": {
        "allocation_id": {
          "$ref": "#/$defs/identifier",
          "description": "Unique allocation identity. It must not be reused for a different plan."
        },
        "plan_ref": {
          "$ref": "#/$defs/identifier",
          "description": "Replication plan associated with this allocation."
        },
        "parent_agent_id": {
          "$ref": "#/$defs/identifier",
          "description": "Parent agent named in the referenced replication plan."
        },
        "reserved_instances": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "Slots currently reserved but not yet activated."
        },
        "active_instances": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "Slots currently occupied, including unresolved termination or retirement."
        },
        "released_instances": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "Cumulative verified release count. This is an audit counter and must not be added to available capacity."
        },
        "allocation_status": {
          "type": "string",
          "enum": [
            "reserved",
            "active",
            "partially_released",
            "released",
            "held"
          ]
        },
        "reserved_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "offspring_ids": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "description": "Known offspring identities associated with this allocation."
        },
        "reservation_ref": {
          "$ref": "#/$defs/identifier",
          "description": "Reference to the externally controlled reservation record."
        },
        "release_records": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/release_record"
          },
          "description": "Independently supported retirement releases. Each released offspring must appear at most once."
        },
        "hold_reason": {
          "type": "string",
          "enum": [
            "verification_pending",
            "retirement_unconfirmed",
            "resource_release_pending",
            "authority_unknown",
            "ledger_conflict",
            "other"
          ]
        },
        "notes": {
          "type": "string",
          "maxLength": 1024
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "allocation_status": {
                "const": "reserved"
              }
            },
            "required": [
              "allocation_status"
            ]
          },
          "then": {
            "properties": {
              "reserved_instances": {
                "minimum": 1
              },
              "active_instances": {
                "const": 0
              },
              "released_instances": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "allocation_status": {
                "const": "active"
              }
            },
            "required": [
              "allocation_status"
            ]
          },
          "then": {
            "properties": {
              "active_instances": {
                "minimum": 1
              },
              "released_instances": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "allocation_status": {
                "const": "partially_released"
              }
            },
            "required": [
              "allocation_status"
            ]
          },
          "then": {
            "properties": {
              "released_instances": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "allocation_status": {
                "const": "released"
              }
            },
            "required": [
              "allocation_status"
            ]
          },
          "then": {
            "properties": {
              "reserved_instances": {
                "const": 0
              },
              "active_instances": {
                "const": 0
              },
              "released_instances": {
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "allocation_status": {
                "const": "held"
              }
            },
            "required": [
              "allocation_status"
            ]
          },
          "then": {
            "required": [
              "hold_reason"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "released_instances": {
                "minimum": 1
              }
            },
            "required": [
              "released_instances"
            ]
          },
          "then": {
            "required": [
              "release_records"
            ],
            "properties": {
              "release_records": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "released_instances": {
                "const": 0
              }
            },
            "required": [
              "released_instances"
            ]
          },
          "then": {
            "properties": {
              "release_records": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "release_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "offspring_id",
        "retirement_ref",
        "termination_verification_ref",
        "resource_release_verification_ref",
        "release_status",
        "verified_at",
        "verifier_id",
        "evidence_refs"
      ],
      "properties": {
        "release_id": {
          "$ref": "#/$defs/identifier"
        },
        "offspring_id": {
          "$ref": "#/$defs/identifier"
        },
        "retirement_ref": {
          "$ref": "#/$defs/identifier",
          "description": "Reference to a v0.3 retirement receipt whose retirement_status is CONFIRMED."
        },
        "termination_verification_ref": {
          "$ref": "#/$defs/identifier"
        },
        "resource_release_verification_ref": {
          "$ref": "#/$defs/identifier"
        },
        "release_status": {
          "type": "string",
          "const": "verified"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "verifier_id": {
          "$ref": "#/$defs/identifier"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "snapshot_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reserved_instances",
        "active_instances",
        "released_instances",
        "committed_instances",
        "available_instances"
      ],
      "properties": {
        "reserved_instances": {
          "type": "integer",
          "minimum": 0
        },
        "active_instances": {
          "type": "integer",
          "minimum": 0
        },
        "released_instances": {
          "type": "integer",
          "minimum": 0
        },
        "committed_instances": {
          "type": "integer",
          "minimum": 0
        },
        "available_instances": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verification_status": {
            "const": "verified"
          }
        },
        "required": [
          "verification_status"
        ]
      },
      "then": {
        "required": [
          "verification_ref",
          "verification_method",
          "verifier_id",
          "evidence_refs"
        ],
        "properties": {
          "evidence_refs": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
