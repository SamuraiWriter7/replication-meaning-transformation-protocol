
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/OWNER/replication-meaning-transformation-protocol/blob/main/schemas/verification-bundle-v0.2.schema.json",
  "title": "RMTP Verification Bundle v0.2",
  "description": "Binds replication intent, meaning conversion, structural evidence, and authority assessment into a non-executable verification result.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "intent_ref",
    "conversion_ref",
    "evidence_refs",
    "authority_ref",
    "verification_time",
    "evidence_result",
    "authority_result",
    "overall_result",
    "execution_authorized"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2.0"
    },
    "bundle_id": {
      "$ref": "#/$defs/identifier"
    },
    "intent_ref": {
      "$ref": "#/$defs/identifier",
      "description": "References the RMTP v0.1 replication intent."
    },
    "conversion_ref": {
      "$ref": "#/$defs/identifier",
      "description": "References the RMTP v0.1 meaning conversion."
    },
    "plan_ref": {
      "$ref": "#/$defs/identifier",
      "description": "Required when a bounded replication plan is proposed."
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "authority_ref": {
      "$ref": "#/$defs/identifier"
    },
    "verification_time": {
      "$ref": "#/$defs/timestamp"
    },
    "evidence_result": {
      "$ref": "#/$defs/result"
    },
    "authority_result": {
      "$ref": "#/$defs/result"
    },
    "overall_result": {
      "$ref": "#/$defs/result"
    },
    "execution_authorized": {
      "type": "boolean",
      "const": false,
      "description": "RMTP verification does not authorize execution."
    },
    "verification_method": {
      "type": "string",
      "enum": [
        "external_registry",
        "signed_attestation",
        "trusted_test_fixture"
      ]
    },
    "verification_records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "HELD"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "overall_result": {
            "const": "PASS"
          }
        },
        "required": [
          "overall_result"
        ]
      },
      "then": {
        "properties": {
          "evidence_result": {
            "const": "PASS"
          },
          "authority_result": {
            "const": "PASS"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_result": {
            "const": "FAIL"
          }
        },
        "required": [
          "evidence_result"
        ]
      },
      "then": {
        "properties": {
          "overall_result": {
            "const": "FAIL"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authority_result": {
            "const": "FAIL"
          }
        },
        "required": [
          "authority_result"
        ]
      },
      "then": {
        "properties": {
          "overall_result": {
            "const": "FAIL"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "overall_result": {
            "const": "PASS"
          }
        },
        "required": [
          "overall_result"
        ]
      },
      "then": {
        "required": [
          "verification_method",
          "verification_records"
        ]
      }
    }
  ]
}
