
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rmtp/schemas/replication-result-reconciliation-v0.5.schema.json",
  "title": "RMTP v0.5 Replication Result Reconciliation",
  "description": "Defines independently verifiable reconciliation decisions for results produced by replicated AI descendants. Preserves provenance, prevents silent conflict overwrite, and does not authorize execution or authority transfer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reconciliation_id",
    "convergence_plan_ref",
    "root_agent_id",
    "target_agent_id",
    "policy_mode",
    "result_records",
    "conflicts",
    "provenance_preserved",
    "authority_transfer_permitted",
    "resource_release_claimed",
    "reconciliation_status",
    "verification_status",
    "verification_time",
    "execution_authorized"
  ],
  "properties": {
    "schema_version": {
      "const": "0.5.0"
    },
    "reconciliation_id": {
      "$ref": "#/$defs/identifier"
    },
    "convergence_plan_ref": {
      "$ref": "#/$defs/identifier"
    },
    "root_agent_id": {
      "$ref": "#/$defs/identifier"
    },
    "target_agent_id": {
      "$ref": "#/$defs/identifier"
    },
    "policy_mode": {
      "type": "string",
      "enum": [
        "verified_only",
        "human_review_required",
        "conflict_hold",
        "no_result_transfer"
      ],
      "description": "Must match the reconciliation policy in the referenced Convergence Plan."
    },
    "result_records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/result_record"
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/conflict_record"
      }
    },
    "provenance_preserved": {
      "const": true
    },
    "authority_transfer_permitted": {
      "const": false,
      "description": "Result reconciliation does not grant or transfer descendant authority."
    },
    "resource_release_claimed": {
      "const": false,
      "description": "Result reconciliation alone cannot assert resource release."
    },
    "reconciliation_status": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "PARTIAL",
        "HELD",
        "REJECTED"
      ]
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "verified",
        "unverified",
        "inconclusive",
        "rejected"
      ]
    },
    "verification_ref": {
      "$ref": "#/$defs/identifier"
    },
    "verification_method": {
      "type": "string",
      "enum": [
        "external_attestation",
        "independent_review",
        "signed_evidence",
        "trusted_test_fixture"
      ]
    },
    "verifier_id": {
      "$ref": "#/$defs/identifier"
    },
    "verification_time": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_refs": {
      "$ref": "#/$defs/evidence_refs"
    },
    "notes": {
      "type": "string",
      "maxLength": 2048
    },
    "execution_authorized": {
      "const": false
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "result_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "origin_descendant_id",
        "origin_plan_ref",
        "lineage_ref",
        "result_integrity_ref",
        "verification_status",
        "decision",
        "decision_reason",
        "provenance_preserved"
      ],
      "properties": {
        "result_id": {
          "$ref": "#/$defs/identifier"
        },
        "origin_descendant_id": {
          "$ref": "#/$defs/identifier"
        },
        "origin_plan_ref": {
          "$ref": "#/$defs/identifier"
        },
        "lineage_ref": {
          "$ref": "#/$defs/identifier"
        },
        "result_integrity_ref": {
          "$ref": "#/$defs/identifier",
          "description": "Reference to integrity evidence for the original result."
        },
        "result_artifact_ref": {
          "$ref": "#/$defs/identifier",
          "description": "Optional reference to the result artifact itself."
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "verified",
            "unverified",
            "inconclusive",
            "rejected"
          ]
        },
        "verification_method": {
          "type": "string",
          "enum": [
            "external_attestation",
            "independent_review",
            "signed_evidence",
            "trusted_test_fixture"
          ]
        },
        "verification_ref": {
          "$ref": "#/$defs/identifier"
        },
        "verifier_id": {
          "$ref": "#/$defs/identifier"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        },
        "decision": {
          "type": "string",
          "enum": [
            "ACCEPTED",
            "REJECTED",
            "HELD",
            "NOT_TRANSFERRED"
          ]
        },
        "decision_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "decision_policy_ref": {
          "$ref": "#/$defs/identifier"
        },
        "reviewer_ref": {
          "$ref": "#/$defs/identifier"
        },
        "conflict_refs": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "provenance_preserved": {
          "const": true
        },
        "target_result_ref": {
          "$ref": "#/$defs/identifier",
          "description": "Optional destination result reference, not proof of physical transfer."
        },
        "derived_result_ref": {
          "$ref": "#/$defs/identifier",
          "description": "If a transformation creates a new result, it must be linked to the original."
        },
        "authority_material_present": {
          "type": "boolean",
          "default": false,
          "description": "Whether potentially transferable credentials or capabilities have been detected."
        },
        "authority_material_handling_ref": {
          "$ref": "#/$defs/identifier"
        },
        "notes": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_status": {
                "const": "verified"
              }
            },
            "required": [
              "verification_status"
            ]
          },
          "then": {
            "required": [
              "verification_method",
              "verification_ref",
              "verifier_id",
              "verified_at",
              "evidence_refs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "const": "ACCEPTED"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "required": [
              "verification_method",
              "verification_ref",
              "verifier_id",
              "verified_at",
              "evidence_refs",
              "decision_policy_ref"
            ],
            "properties": {
              "verification_status": {
                "const": "verified"
              },
              "authority_material_present": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "authority_material_present": {
                "const": true
              }
            },
            "required": [
              "authority_material_present"
            ]
          },
          "then": {
            "required": [
              "authority_material_handling_ref"
            ],
            "properties": {
              "decision": {
                "enum": [
                  "HELD",
                  "REJECTED",
                  "NOT_TRANSFERRED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "decision": {
                "const": "NOT_TRANSFERRED"
              }
            },
            "required": [
              "decision"
            ]
          },
          "then": {
            "not": {
              "required": [
                "target_result_ref"
              ]
            }
          }
        }
      ]
    },
    "conflict_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conflict_id",
        "result_refs",
        "conflict_type",
        "resolution_status",
        "resolution_method",
        "evidence_refs"
      ],
      "properties": {
        "conflict_id": {
          "$ref": "#/$defs/identifier"
        },
        "result_refs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "conflict_type": {
          "type": "string",
          "enum": [
            "semantic_incompatibility",
            "provenance_disagreement",
            "integrity_disagreement",
            "policy_conflict",
            "duplicate_result_identity",
            "other"
          ]
        },
        "conflict_description": {
          "type": "string",
          "maxLength": 2048
        },
        "resolution_status": {
          "type": "string",
          "enum": [
            "unresolved",
            "resolved",
            "rejected"
          ]
        },
        "resolution_method": {
          "type": "string",
          "enum": [
            "hold",
            "human_review",
            "authorized_deterministic_resolution",
            "reject_conflicting_results"
          ]
        },
        "resolution_policy_ref": {
          "$ref": "#/$defs/identifier"
        },
        "resolution_verification_ref": {
          "$ref": "#/$defs/identifier"
        },
        "resolver_id": {
          "$ref": "#/$defs/identifier"
        },
        "resolved_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidence_refs"
        },
        "notes": {
          "type": "string",
          "maxLength": 2048
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resolution_status": {
                "const": "unresolved"
              }
            },
            "required": [
              "resolution_status"
            ]
          },
          "then": {
            "properties": {
              "resolution_method": {
                "const": "hold"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resolution_method": {
                "const": "authorized_deterministic_resolution"
              }
            },
            "required": [
              "resolution_method"
            ]
          },
          "then": {
            "required": [
              "resolution_policy_ref",
              "resolution_verification_ref",
              "resolver_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "resolution_status": {
                "const": "resolved"
              }
            },
            "required": [
              "resolution_status"
            ]
          },
          "then": {
            "required": [
              "resolution_verification_ref",
              "resolver_id",
              "resolved_at"
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verification_status": {
            "const": "verified"
          }
        },
        "required": [
          "verification_status"
        ]
      },
      "then": {
        "required": [
          "verification_ref",
          "verification_method",
          "verifier_id",
          "evidence_refs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "reconciliation_status": {
            "const": "COMPLETED"
          }
        },
        "required": [
          "reconciliation_status"
        ]
      },
      "then": {
        "required": [
          "verification_ref",
          "verification_method",
          "verifier_id",
          "evidence_refs"
        ],
        "properties": {
          "verification_status": {
            "const": "verified"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy_mode": {
            "const": "no_result_transfer"
          }
        },
        "required": [
          "policy_mode"
        ]
      },
      "then": {
        "properties": {
          "result_records": {
            "items": {
              "properties": {
                "decision": {
                  "const": "NOT_TRANSFERRED"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "policy_mode": {
            "const": "conflict_hold"
          }
        },
        "required": [
          "policy_mode"
        ]
      },
      "then": {
        "properties": {
          "result_records": {
            "items": {
              "properties": {
                "decision": {
                  "enum": [
                    "HELD",
                    "REJECTED",
                    "NOT_TRANSFERRED"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ]
}
